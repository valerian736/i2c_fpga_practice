wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_ibuf (
    .O(rst_d),
    .I(rst) 
);
  OBUF test_led_obuf (
    .O(test_led),
    .I(test_led_d) 
);
  OBUF tx_obuf (
    .O(tx),
    .I(tx_d) 
);
