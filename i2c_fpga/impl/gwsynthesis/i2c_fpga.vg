    .clk_d(clk_d),
    .rst_d(rst_d),
    .test_led_d(test_led_d)
);
  uart_tx uart_test (
    .clk_d(clk_d),
    .rst_d(rst_d),
    .clockout_prev(clockout_prev),
    .test_led_d(test_led_d),
    .tx_d(tx_d)
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
